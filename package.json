{
  "name": "luach-mvp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint app src lib constants hooks",
    "test:reminders": "npx --yes esbuild scripts/test-reminder-rules.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/test.mjs --packages=external --alias:@=. && node scripts/.test-out/test.mjs",
    "test:knowledge": "npx --yes esbuild scripts/test-knowledge-databases.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/knowledge.mjs --packages=external --alias:@=. && node scripts/.test-out/knowledge.mjs",
    "convert:excel-databases": "node scripts/convert-excel-databases.mjs",
    "convert:yahrzeits": "node scripts/convert-yahrzeits.mjs",
    "convert:jewish-history": "node scripts/convert-jewish-history.mjs",
    "convert:minhagim-segulot": "node scripts/convert-minhagim-segulot.mjs",
    "reminders:export-master": "npx --yes esbuild scripts/reminders-export-master.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/reminders-export-master.mjs --packages=external --alias:@=. && node scripts/.test-out/reminders-export-master.mjs",
    "reminders:build": "npx --yes esbuild scripts/reminders-build.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/reminders-build.mjs --packages=external --alias:@=. && node scripts/.test-out/reminders-build.mjs",
    "reminders:validate": "npx --yes esbuild scripts/reminders-build.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/reminders-build.mjs --packages=external --alias:@=. && node scripts/.test-out/reminders-build.mjs --validate-only",
    "test:reminder-content": "npx --yes esbuild scripts/test-reminder-content.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/reminder-content.mjs --packages=external --alias:@=. && node scripts/.test-out/reminder-content.mjs",
    "test:calendar": "npx --yes esbuild scripts/test-calendar-week-layout.ts --bundle --platform=node --format=esm --outfile=scripts/.test-out/calendar.mjs --packages=external --alias:@=. && node scripts/.test-out/calendar.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hebcal/core": "^6.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "xlsx": "^0.18.5"
  },
  "private": true
}
